{
  "name": "tool-contract-replay-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for snapshotting, diffing, and replaying MCP tool contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohuxi/tool-contract-replay-mcp.git"
  },
  "type": "module",
  "bin": {
    "tool-contract-replay-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "start": "node dist/index.js"
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
